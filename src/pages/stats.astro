---
import "../styles/global.css";
import StatsCard from "../components/StatsCard";
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary Meta Tags -->
		<title>Estatísticas | Mega-Sena a Cada Segundo</title>
		<meta name="description" content="Entenda as probabilidades da Mega-Sena. Veja suas estatísticas pessoais e aprenda sobre as chances de ganhar na loteria." />

		<!-- Favicon -->
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🍀</text></svg>" />

		<!-- Theme Color -->
		<meta name="theme-color" content="#10b981" />
	</head>
	<body class="bg-gradient-to-br from-green-50 via-emerald-50 to-teal-50 min-h-screen">
		<div class="container mx-auto px-4 py-8">
			<!-- Header -->
			<header class="text-center mb-12">
				<h1 class="text-5xl md:text-6xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-green-600 to-emerald-600 mb-4">
					Estatísticas da Mega-Sena
				</h1>
				<p class="text-xl text-gray-700 mb-2">
					Entenda as probabilidades e veja os números
				</p>

				<!-- Navigation -->
				<nav class="mt-6 flex gap-4 justify-center">
					<a href="/" class="px-6 py-2 bg-gray-600 text-white rounded-lg font-semibold hover:bg-gray-700 transition-colors">
						Jogar
					</a>
					<a href="/history" class="px-6 py-2 bg-gray-600 text-white rounded-lg font-semibold hover:bg-gray-700 transition-colors">
						Histórico
					</a>
					<a href="/stats" class="px-6 py-2 bg-purple-600 text-white rounded-lg font-semibold hover:bg-purple-700 transition-colors">
						Estatísticas
					</a>
				</nav>
			</header>

			<!-- Main Content -->
			<main class="max-w-4xl mx-auto">
				<StatsCard client:load />
			</main>

			<!-- Footer -->
			<footer class="text-center mt-16 text-gray-600 text-sm">
				<p>Projeto educacional para demonstrar a probabilidade da Mega-Sena</p>
			</footer>
		</div>
	</body>
</html>
