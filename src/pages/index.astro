---
import "../styles/global.css";
import PlaySection from "../components/PlaySection";
import StatsCard from "../components/StatsCard";
import HistoryTable from "../components/HistoryTable";
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary Meta Tags -->
		<title>Mega-Sena a Cada Segundo</title>
		<meta name="title" content="Mega-Sena a Cada Segundo" />
		<meta name="description" content="Por que esperar uma semana pela decepção quando você pode tê-la a cada segundo? Simulador educacional da Mega-Sena que demonstra em tempo real a probabilidade de ganhar na loteria." />
		<meta name="keywords" content="mega-sena, loteria, simulador, probabilidade, estatística, educacional, Brasil, sorteio" />
		<meta name="author" content="Gilson Urbano" />
		<meta name="robots" content="index, follow" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://loteria.urbanogilson.com/" />
		<meta property="og:title" content="Mega-Sena a Cada Segundo" />
		<meta property="og:description" content="Por que esperar uma semana pela decepção quando você pode tê-la a cada segundo? Veja em tempo real como é difícil ganhar na loteria!" />
		<meta property="og:locale" content="pt_BR" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content="https://loteria.urbanogilson.com/" />
		<meta property="twitter:title" content="Mega-Sena a Cada Segundo" />
		<meta property="twitter:description" content="Por que esperar uma semana pela decepção quando você pode tê-la a cada segundo? Veja em tempo real como é difícil ganhar na loteria!" />

		<!-- Favicon -->
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🍀</text></svg>" />
		<link rel="apple-touch-icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🍀</text></svg>" />

		<!-- Theme Color -->
		<meta name="theme-color" content="#10b981" />
	</head>
	<body class="bg-gradient-to-br from-green-50 via-emerald-50 to-teal-50 min-h-screen">
		<div class="container mx-auto px-3 sm:px-4 py-4 sm:py-8">
			<!-- Header -->
			<header class="max-w-6xl mx-auto text-center mb-6 md:mb-10">
				<h1 class="text-3xl p-3 sm:text-4xl md:text-5xl lg:text-6xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-green-600 to-emerald-600 mb-2 md:mb-3">
					🍀Mega-Sena a Cada Segundo
				</h1>
				<p class="text-lg md:text-xl font-bold text-green-700 mb-2">
					🎰 Por que esperar uma semana pela decepção quando você pode tê-la a cada segundo?
				</p>
				<p class="text-base sm:text-lg md:text-xl text-gray-700 mb-1">
					Veja os sonhos se tornarem realidade (ou não) em tempo real. Este simulador demonstra visualmente a probabilidade extremamente baixa de ganhar na loteria.				</p>
				<p class="text-sm md:text-base text-gray-600">
					Um novo sorteio acontece a cada segundo!
				</p>
			</header>

			<!-- Main Content -->
			<main class="max-w-6xl mx-auto space-y-10 md:space-y-12">
				<!-- Play Section -->
				<section>
					<PlaySection client:load />
				</section>

				<!-- Stats Section -->
				<section class="pt-8 md:pt-10">
					<div class="text-center mb-6 md:mb-8">
						<h2 class="text-2xl md:text-3xl font-bold text-gray-800 mb-2">📊 Suas Estatísticas</h2>
						<p class="text-sm md:text-base text-gray-600">Acompanhe seu desempenho e entenda as probabilidades</p>
					</div>
					<StatsCard client:load />
				</section>

				<!-- History Section -->
				<section class="pt-8 md:pt-10">
					<div class="text-center mb-6 md:mb-8">
						<h2 class="text-2xl md:text-3xl font-bold text-gray-800 mb-2">🏆 Histórico de Vitórias</h2>
						<p class="text-sm md:text-base text-gray-600">Seus melhores resultados (4+ acertos)</p>
					</div>
					<HistoryTable client:load />
				</section>
			</main>

			<!-- Footer -->
			<footer class="text-center mt-12 md:mt-16 pt-8 md:pt-10 border-t-2 border-green-300">
				<div class="text-gray-600 text-xs md:text-sm space-y-3">
					<p class="font-semibold">Projeto educacional open-source</p>
					<a
						href="https://github.com/urbanogilson/loteria-a-cada-segundo"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700 text-white rounded-lg font-semibold transition-all shadow-md hover:shadow-lg active:scale-95"
					>
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
							<path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
						</svg>
						Ver no GitHub
					</a>
					<p class="text-xs text-gray-500 mt-3">
						Jogue com responsabilidade. Este é um simulador educacional. 🎲
					</p>
				</div>
			</footer>
		</div>
	</body>
</html>
